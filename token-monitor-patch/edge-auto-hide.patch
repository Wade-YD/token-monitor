diff --git a/tests/shared/zcodeSessionDetail.test.js b/tests/shared/zcodeSessionDetail.test.js
new file mode 100644
index 0000000..49cd7e8
--- /dev/null
+++ b/tests/shared/zcodeSessionDetail.test.js
@@ -0,0 +1,114 @@
+'use strict';
+
+const assert = require('node:assert/strict');
+const fs = require('node:fs');
+const os = require('node:os');
+const path = require('node:path');
+const test = require('node:test');
+const { DatabaseSync } = require('node:sqlite');
+const nodeSqlite = require('node:sqlite');
+
+const { readSessionDetail } = require('../../src/shared/sessionDetail');
+
+const tmpDirs = [];
+test.after(() => {
+  for (const dir of tmpDirs) fs.rmSync(dir, { recursive: true, force: true });
+});
+
+const T0 = Date.UTC(2026, 8, 16, 14, 0, 0);
+const T1 = Date.UTC(2026, 8, 16, 14, 0, 6);
+const T2 = Date.UTC(2026, 8, 16, 14, 1, 0);
+const T3 = Date.UTC(2026, 8, 16, 14, 1, 8);
+const END = T3 + 1000;
+
+function makeFixture() {
+  const dir = fs.mkdtempSync(path.join(os.tmpdir(), 'token-monitor-zcode-detail-'));
+  tmpDirs.push(dir);
+  const file = path.join(dir, 'db.sqlite');
+  const db = new DatabaseSync(file);
+  db.exec('CREATE TABLE message (id TEXT PRIMARY KEY, session_id TEXT, time_created INTEGER, time_updated INTEGER, data TEXT, sequence INTEGER)');
+  db.exec('CREATE TABLE part (id TEXT PRIMARY KEY, message_id TEXT, session_id TEXT, time_created INTEGER, time_updated INTEGER, data TEXT, sequence INTEGER)');
+  const insM = db.prepare('INSERT INTO message (id, session_id, time_created, time_updated, data, sequence) VALUES (?,?,?,?,?,?)');
+  const asst = (tokens) => JSON.stringify({ role: 'assistant', cost: 0, tokens, time: { created: null } });
+  insM.run('m0', 's1', T0, T0, JSON.stringify({ role: 'user', time: { created: T0 } }), 1);
+  insM.run('m1', 's1', T1, T1, asst({ total: 300, input: 200, output: 100, reasoning: 20, cache: { read: 0, write: 0 } }), 2);
+  insM.run('m2', 's1', T2, T2, JSON.stringify({ role: 'user', time: { created: T2 } }), 3);
+  insM.run('m3', 's1', T3, T3, asst({ total: 100, input: 60, output: 30, reasoning: 0, cache: { read: 10, write: 0 } }), 4);
+  const insP = db.prepare('INSERT INTO part (id, message_id, session_id, time_created, time_updated, data, sequence) VALUES (?,?,?,?,?,?,?)');
+  insP.run('p0', 'm0', 's1', T0, T0, JSON.stringify({ type: 'text', text: '帮我查一下配置' }));
+  insP.run('p1', 'm1', 's1', T1, T1, JSON.stringify({ type: 'tool', tool: 'Bash' }));
+  insP.run('p2', 'm2', 's1', T2, T2, JSON.stringify({ type: 'text', text: '再看一遍日志' }));
+  db.close();
+  return file;
+}
+
+test('readSessionDetail(zcode) groups exchanges with prompt previews and tools', (t) => {
+  const file = makeFixture();
+  const detail = readSessionDetail({
+    client: 'zcode', sessionId: 's1', period: 'total', sessionCost: 1,
+    home: os.tmpdir(), deps: { zcodeDeps: { dbPath: file, sqlite: nodeSqlite }, now: () => END }
+  });
+  assert.equal(detail.found, true);
+  assert.equal(detail.exchanges.length, 2);
+
+  const [ex1, ex2] = detail.exchanges;
+  assert.equal(ex1.promptPreview, '帮我查一下配置');
+  assert.equal(ex1.turnCount, 1);
+  assert.equal(ex1.tokens.total, 300);
+  assert.deepEqual(ex1.turns[0].tools, ['Bash']);
+
+  assert.equal(ex2.promptPreview, '再看一遍日志');
+  assert.equal(ex2.turnCount, 1);
+  assert.equal(ex2.tokens.total, 100);
+});
+
+test('readSessionDetail(zcode) distributes the estimated session cost across turns', (t) => {
+  const file = makeFixture();
+  const detail = readSessionDetail({
+    client: 'zcode', sessionId: 's1', period: 'total', sessionCost: 1,
+    home: os.tmpdir(), deps: { zcodeDeps: { dbPath: file, sqlite: nodeSqlite }, now: () => END }
+  });
+  assert.equal(detail.totals.costUsd, 1);
+  const costSum = detail.exchanges.reduce((acc, ex) => acc + ex.costEstimate, 0);
+  assert.ok(Math.abs(costSum - 1) < 1e-9, 'distributed costs must sum to the session estimate');
+  // 300:100 token split -> 0.75 / 0.25
+  assert.ok(Math.abs(detail.exchanges[0].costEstimate - 0.75) < 1e-9);
+  assert.ok(Math.abs(detail.exchanges[1].costEstimate - 0.25) < 1e-9);
+});
+
+test('readSessionDetail(zcode) reports found:false for an unknown session', (t) => {
+  const file = makeFixture();
+  const detail = readSessionDetail({
+    client: 'zcode', sessionId: 'sess_nope', period: 'total',
+    home: os.tmpdir(), deps: { zcodeDeps: { dbPath: file, sqlite: nodeSqlite }, now: () => END }
+  });
+  assert.equal(detail.found, false);
+  assert.equal(detail.exchanges.length, 0);
+});
+
+test('readSessionDetail(zcode) degrades when the database is missing or corrupt', (t) => {
+  const missing = readSessionDetail({
+    client: 'zcode', sessionId: 's1', period: 'total',
+    home: os.tmpdir(), deps: { zcodeDeps: { dbPath: path.join(os.tmpdir(), 'nope', 'db.sqlite'), sqlite: nodeSqlite } }
+  });
+  assert.equal(missing.found, false);
+
+  const dir = fs.mkdtempSync(path.join(os.tmpdir(), 'token-monitor-zcode-detail-bad-'));
+  tmpDirs.push(dir);
+  const bad = path.join(dir, 'db.sqlite');
+  fs.writeFileSync(bad, 'not a database');
+  const corrupt = readSessionDetail({
+    client: 'zcode', sessionId: 's1', period: 'total',
+    home: os.tmpdir(), deps: { zcodeDeps: { dbPath: bad, sqlite: nodeSqlite } }
+  });
+  assert.equal(corrupt.found, false);
+});
+
+test('the renderer whitelists zcode in both detail gates', () => {
+  const source = fs.readFileSync(
+    path.join(__dirname, '..', '..', 'src', 'electron', 'renderer', 'app.js'),
+    'utf8'
+  );
+  assert.match(source, /\['claude', 'codex', 'opencode', 'dsh', 'zcode'\]\.includes\(client\)/);
+  assert.match(source, /client !== 'zcode'\) return;/);
+});
diff --git a/tests/shared/zcodeSessionMetadata.test.js b/tests/shared/zcodeSessionMetadata.test.js
new file mode 100644
index 0000000..9d340a5
--- /dev/null
+++ b/tests/shared/zcodeSessionMetadata.test.js
@@ -0,0 +1,145 @@
+'use strict';
+
+const assert = require('node:assert/strict');
+const fs = require('node:fs');
+const os = require('node:os');
+const path = require('node:path');
+const test = require('node:test');
+const { DatabaseSync } = require('node:sqlite');
+
+const zcodeSessionMetadata = require('../../src/shared/providers/zcode/sessionMetadata');
+
+const SCHEMA = `
+CREATE TABLE session (
+  id TEXT PRIMARY KEY,
+  title TEXT,
+  parent_id TEXT,
+  task_type TEXT,
+  time_created INTEGER,
+  time_updated INTEGER
+);
+`;
+
+function fixtureDb(t, rows) {
+  const dir = fs.mkdtempSync(path.join(os.tmpdir(), 'token-monitor-zcode-titles-'));
+  t.after(() => fs.rmSync(dir, { recursive: true, force: true }));
+  const file = path.join(dir, 'db.sqlite');
+  const db = new DatabaseSync(file);
+  db.exec(SCHEMA);
+  const insert = db.prepare(
+    'INSERT INTO session (id, title, parent_id, task_type, time_created, time_updated) VALUES (?, ?, ?, ?, ?, ?)'
+  );
+  for (const row of rows) insert.run(...row);
+  db.close();
+  return file;
+}
+
+function resolve(file, ids, extraDeps = {}) {
+  return zcodeSessionMetadata.resolveSessionMetadata(new Set(ids), {
+    home: os.tmpdir(),
+    deps: { zcodeDeps: { dbPath: file, ...extraDeps } }
+  });
+}
+
+test('a titled session resolves its title and epoch-ms timestamps', (t) => {
+  const file = fixtureDb(t, [
+    ['sess_abc', '工作台网站交接文档优化分析', null, 'interactive', 1789479536728, 1789577827928]
+  ]);
+  const meta = resolve(file, ['sess_abc']);
+  assert.equal(meta.size, 1);
+  const row = meta.get('sess_abc');
+  assert.equal(row.title, '工作台网站交接文档优化分析');
+  assert.equal(row.startedAt, new Date(1789479536728).toISOString());
+  assert.equal(row.lastUsedAt, new Date(1789577827928).toISOString());
+});
+
+test('an unknown session id and an empty title both stay out of the title column', (t) => {
+  const file = fixtureDb(t, [
+    ['sess_known', '', null, 'interactive', 111, 222],
+    ['sess_other', '', null, 'interactive', null, null]
+  ]);
+  const meta = resolve(file, ['sess_missing', 'sess_known', 'sess_other']);
+  assert.equal(meta.has('sess_missing'), false, 'id not in the store must not appear');
+  assert.equal(meta.get('sess_known').title, '');
+  assert.equal(meta.get('sess_known').startedAt, new Date(111).toISOString());
+  assert.equal(meta.has('sess_other'), false, 'no title and no times -> nothing to contribute');
+});
+
+test('a subagent session renders as arrow + kind label + parent title', (t) => {
+  const file = fixtureDb(t, [
+    ['sess_parent', 'Token-monitor 改进', null, 'interactive', 1, 2],
+    ['sess_subagent_agent_x', '你是代码审查员。审查一个 PWA……', 'sess_parent', 'subagent_child', 3, 4]
+  ]);
+  const meta = resolve(file, ['sess_subagent_agent_x']);
+  assert.equal(meta.get('sess_subagent_agent_x').title, '\u21b3 子代理 · Token-monitor 改进');
+});
+
+test('a selection side chat renders with the side-chat label', (t) => {
+  const file = fixtureDb(t, [
+    ['sess_parent', '工作台网站交接文档优化分析', null, 'interactive', 1, 2],
+    ['sess_side', '选中内容的问题', 'sess_parent', 'selection_side_chat', 3, 4]
+  ]);
+  const meta = resolve(file, ['sess_side']);
+  assert.equal(meta.get('sess_side').title, '\u21b3 侧聊 · 工作台网站交接文档优化分析');
+});
+
+test('an unmapped child task type falls through to its raw value', (t) => {
+  const file = fixtureDb(t, [
+    ['sess_parent', '父标题', null, 'interactive', 1, 2],
+    ['sess_child', '提示词', 'sess_parent', 'review_panel', 3, 4]
+  ]);
+  const meta = resolve(file, ['sess_child']);
+  assert.equal(meta.get('sess_child').title, '\u21b3 review_panel · 父标题');
+});
+
+test('a subagent resolves the parent title even when the parent is in the same batch', (t) => {
+  const file = fixtureDb(t, [
+    ['sess_parent', '工作台网站交接文档优化分析', null, 'interactive', 1, 2],
+    ['sess_subagent_agent_y', '你是代码审查员。……', 'sess_parent', 'subagent_child', 3, 4]
+  ]);
+  const meta = resolve(file, ['sess_parent', 'sess_subagent_agent_y']);
+  assert.equal(meta.get('sess_subagent_agent_y').title, '\u21b3 子代理 · 工作台网站交接文档优化分析');
+});
+
+test('a child falls back to its own title when the parent has none or is missing', (t) => {
+  const file = fixtureDb(t, [
+    ['sess_parent_mute', '', null, 'interactive', 1, 2],
+    ['sess_sub_a', '审查任务提示词', 'sess_parent_mute', 'subagent_child', 3, 4],
+    ['sess_sub_b', '另一个子代理提示词', 'sess_parent_gone', 'subagent_child', 5, 6]
+  ]);
+  const meta = resolve(file, ['sess_sub_a', 'sess_sub_b']);
+  assert.equal(meta.get('sess_sub_a').title, '审查任务提示词', 'parent without a title -> own title, no label');
+  assert.equal(meta.get('sess_sub_b').title, '另一个子代理提示词', 'parent row missing -> own title, no label');
+});
+
+test('a missing database file degrades to an empty map', () => {
+  const meta = resolve(path.join(os.tmpdir(), 'token-monitor-zcode-nope', 'db.sqlite'), ['sess_abc']);
+  assert.equal(meta.size, 0);
+});
+
+test('a corrupted database file degrades to an empty map', (t) => {
+  const dir = fs.mkdtempSync(path.join(os.tmpdir(), 'token-monitor-zcode-bad-'));
+  t.after(() => fs.rmSync(dir, { recursive: true, force: true }));
+  const file = path.join(dir, 'db.sqlite');
+  fs.writeFileSync(file, 'this is not a sqlite database, just bytes');
+  const meta = resolve(file, ['sess_abc']);
+  assert.equal(meta.size, 0);
+});
+
+test('a missing sqlite driver degrades to an empty map', (t) => {
+  const file = fixtureDb(t, [['sess_abc', 'T', null, 'interactive', 1, 2]]);
+  const meta = zcodeSessionMetadata.resolveSessionMetadata(new Set(['sess_abc']), {
+    home: os.tmpdir(),
+    deps: { zcodeDeps: { dbPath: file, sqlite: null } }
+  });
+  assert.equal(meta.size, 0);
+});
+
+test('sessionMetadata registers the zcode resolver with the retry policy', () => {
+  const source = fs.readFileSync(
+    path.join(__dirname, '..', '..', 'src', 'shared', 'sessionMetadata.js'),
+    'utf8'
+  );
+  assert.match(source, /require\('\.\/providers\/zcode\/sessionMetadata'\)/);
+  assert.match(source, /\['zcode', \{ resolve: zcodeSessionMetadata\.resolveSessionMetadata, retryAfterTimestampFallback: true \}\]/);
+});
