+function defaultDbPath(home) {
+  const base = String(home || process.env.USERPROFILE || process.env.HOME || '').trim();
+  return base ? path.join(base, '.zcode', 'cli', 'db', 'db.sqlite') : '';
+}
+
+function resolveSqlite(zcodeDeps) {
+  if (zcodeDeps && zcodeDeps.sqlite !== undefined) return zcodeDeps.sqlite;
+  return sqlite;
+}
+
+function isoFromMs(ms) {
+  const n = Number(ms);
+  return Number.isFinite(n) && n > 0 ? new Date(n).toISOString() : '';
+}
+
+function cleanTitle(text) {
+  return String(text || '').replace(/\s+/g, ' ').trim();
+}
+
+function resolveSessionMetadata(sessionIds, context = {}) {
+  const result = new Map();
+  const deps = context.deps || {};
+  const zcodeDeps = deps.zcodeDeps || {};
+  const sqliteMod = resolveSqlite(zcodeDeps);
+  if (!sqliteMod) return result;
+
+  const dbPath = zcodeDeps.dbPath || defaultDbPath(context.home);
+  if (!dbPath) return result;
+
+  const wanted = [...(sessionIds || [])].map((id) => String(id || '').trim()).filter(Boolean);
+  if (wanted.length === 0) return result;
+
+  let db;
+  try {
+    db = openDb(dbPath, sqliteMod);
+    const rows = fetchRows(db, wanted);
+    if (rows.size === 0) return result;
+
+    // Parent titles for subagent rows: resolved in a second bounded query so a
+    // parent outside the requested set still answers. A parent inside the set
+    // is answered from the already-fetched rows.
+    const parentIds = new Set();
+    for (const row of rows.values()) {
+      if (row.parentId && !rows.has(row.parentId)) parentIds.add(row.parentId);
+    }
+    const parentTitles = parentIds.size > 0 ? fetchParentTitles(db, parentIds) : new Map();
+
+    for (const [id, row] of rows) {
+      const startedAt = isoFromMs(row.timeCreated);
+      const lastUsedAt = isoFromMs(row.timeUpdated);
+      const ownTitle = cleanTitle(row.title);
+      let title = ownTitle;
+      if (row.parentId) {
+        const parentTitle = cleanTitle(rows.get(row.parentId)?.title) || parentTitles.get(row.parentId);
+        if (parentTitle) {
+          const label = childTypeLabel(row.taskType);
+          title = SUBAGENT_TITLE_PREFIX + (label ? label + ' · ' : '') + parentTitle;
+        }
+      }
+      if (!startedAt && !lastUsedAt && !title) continue;
+      result.set(id, { startedAt, lastUsedAt, title });
+    }
+  } catch (_) {
+    // A missing, locked-out, or corrupted store must never break the session
+    // list: return whatever was gathered (possibly nothing) and let the row
+    // fall back to the bare id.
+  } finally {
+    if (db) {
+      try { db.close(); } catch (_) {}
+    }
+  }
+  return result;
+}
+
+function openDb(dbPath, sqliteMod) {
+  // Accept either the node:sqlite module object or the DatabaseSync class
+  // itself — test seams pass whichever is at hand.
+  const Sync = sqliteMod.DatabaseSync || sqliteMod;
+  const db = new Sync(dbPath, { readOnly: true });
+  db.exec('PRAGMA busy_timeout = 250');
+  return db;
+}
+
+function fetchRows(db, ids) {
+  const rows = new Map();
+  const placeholders = ids.map(() => '?').join(',');
+  const stmt = db.prepare(
+    `SELECT id, title, parent_id AS parentId, task_type AS taskType,
+            time_created AS timeCreated, time_updated AS timeUpdated
+       FROM session WHERE id IN (${placeholders})`
+  );
+  for (const row of stmt.all(...ids)) {
+    if (!row || !row.id) continue;
+    rows.set(String(row.id), row);
+  }
+  return rows;
+}
+
+function fetchParentTitles(db, parentIds) {
+  const titles = new Map();
+  const ids = [...parentIds];
+  const placeholders = ids.map(() => '?').join(',');
+  const stmt = db.prepare(`SELECT id, title FROM session WHERE id IN (${placeholders})`);
+  for (const row of stmt.all(...ids)) {
+    const title = cleanTitle(row?.title);
+    if (row?.id && title) titles.set(String(row.id), title);
+  }
+  return titles;
+}
+
+// ---------------------------------------------------------------------------
+// Session detail events (neutral shape consumed by sessionDetail.js)
+// ---------------------------------------------------------------------------
+const MESSAGES_SQL =
+  `SELECT id,
+          CAST(COALESCE(json_extract(data,'$.time.created'), time_created) AS INTEGER) AS createdMs,
+          json_extract(data,'$.role')             AS role,
+          json_extract(data,'$.cost')             AS cost,
+          json_extract(data,'$.tokens.input')           AS tInput,
+          json_extract(data,'$.tokens.output')          AS tOutput,
+          json_extract(data,'$.tokens.reasoning')       AS tReasoning,
+          json_extract(data,'$.tokens.cache.read')      AS tCacheRead,
+          json_extract(data,'$.tokens.cache.write')     AS tCacheWrite
+   FROM message
+   WHERE session_id = ? AND json_valid(data)
+   ORDER BY sequence ASC, id ASC`;
+
+const PARTS_SQL =
+  `SELECT message_id AS messageId,
+          json_extract(data,'$.type') AS type,
+          json_extract(data,'$.text') AS text,
+          json_extract(data,'$.tool') AS tool
+   FROM part
+   WHERE session_id = ? AND json_valid(data)
+   ORDER BY time_created ASC, id ASC`;
+
+function num(value) {
+  const n = Number(value);
+  return Number.isFinite(n) ? n : 0;
+}
+
+function mapTokens(r) {
+  const input = num(r.tInput);
+  const output = num(r.tOutput);
+  const reasoning = num(r.tReasoning);
+  const cacheRead = num(r.tCacheRead);
+  const cacheWrite = num(r.tCacheWrite);
+  // Same convention as the other clients: reasoning is a subset of output and
+  // stays informational; the session total is in + out + cacheRead + cacheWrite.
+  const total = input + output + cacheRead + cacheWrite;
+  return { input, output, cacheRead, cacheWrite, reasoning, total };
+}
+
+function buildEvents(messages, parts) {
+  const textByMessage = new Map();
+  const toolsByMessage = new Map();
+  for (const p of parts) {
+    if (p.type === 'text' && p.text) {
+      if (!textByMessage.has(p.messageId)) textByMessage.set(p.messageId, []);
+      textByMessage.get(p.messageId).push(String(p.text));
+    } else if (p.type === 'tool' && p.tool) {
+      if (!toolsByMessage.has(p.messageId)) toolsByMessage.set(p.messageId, []);
+      toolsByMessage.get(p.messageId).push(String(p.tool));
+    }
+  }
+
+  const events = [];
+  let sessionCost = 0;
+  for (const m of messages) {
+    const timestamp = isoFromMs(m.createdMs);
+    if (m.role === 'user') {
+      const text = cleanTitle((textByMessage.get(m.id) || []).join(' '));
+      events.push({ kind: 'prompt', timestamp, text });
+    } else if (m.role === 'assistant') {
+      const cost = num(m.cost);
+      sessionCost += cost;
+      const tools = Array.from(new Set(toolsByMessage.get(m.id) || []));
+      events.push({ kind: 'turn', timestamp, tokens: mapTokens(m), tools, cost });
+    }
+  }
+  return { events, sessionCost };
+}
+
+function readSessionEvents(sessionId, deps = {}) {
+  const empty = { found: false, events: [], sessionCost: 0 };
+  const id = String(sessionId || '').trim();
+  if (!id) return empty;
+  const sqliteMod = resolveSqlite(deps);
+  if (!sqliteMod) return empty;
+  const dbPath = deps.dbPath || defaultDbPath(deps.home);
+  if (!dbPath) return empty;
+
+  let db;
+  try {
+    db = openDb(dbPath, sqliteMod);
+    const messages = db.prepare(MESSAGES_SQL).all(id);
+    if (messages.length === 0) return empty;
+    const parts = db.prepare(PARTS_SQL).all(id);
+    const built = buildEvents(messages, parts);
+    return { found: true, ...built };
+  } catch (_) {
+    return empty;
+  } finally {
+    if (db) {
+      try { db.close(); } catch (_) {}
+    }
+  }
+}
+
+module.exports = { resolveSessionMetadata, readSessionEvents, defaultDbPath, SUBAGENT_TITLE_PREFIX };
