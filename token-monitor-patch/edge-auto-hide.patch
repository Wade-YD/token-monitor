+  return fs.readFileSync(path.join(__dirname, '..', '..', 'src', 'electron', 'main.js'), 'utf8');
+}
+
+function readControllerSource() {
+  return fs.readFileSync(path.join(__dirname, '..', '..', 'src', 'electron', 'edgeAutoHideController.js'), 'utf8');
+}
